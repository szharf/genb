            "type": "string",
            "maxLength": 32000,
            "minLength": 1,
            "title": "Usermessage"
          },
          "assistantMessage": {
            "type": "string",
            "maxLength": 64000,
            "title": "Assistantmessage"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "title": "Occurredat"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "turnId",
          "userMessage",
          "assistantMessage",
          "occurredAt"
        ],
        "title": "ExtractionRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PrepareContextRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 16000,
            "minLength": 1,
            "title": "Query"
          },
          "maxContextTokens": {
            "type": "integer",
            "maximum": 64000.0,
            "minimum": 1.0,
            "title": "Maxcontexttokens"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query",
          "maxContextTokens"
        ],
        "title": "PrepareContextRequest"
      },
      "SearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 16000,
            "title": "Query",
            "default": ""
          },
          "types": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "enum": [
                    "USER_PREFERENCE",
                    "STABLE_FACT",
                    "USER_CONSTRAINT"
                  ]
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Types"
          },
          "topK": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Topk"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SearchRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "ServiceCredential": {
        "type": "http",
        "description": "GenB-issued service credential",
        "scheme": "bearer"
      },
      "ActorToken": {
        "type": "apiKey",
        "description": "GenB-issued signed Actor Token",
        "in": "header",
        "name": "X-GenB-Actor-Token"
      }
    }
  }
