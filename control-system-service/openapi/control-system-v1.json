            "minLength": 1,
            "title": "Usermessage",
            "type": "string"
          }
        },
        "required": [
          "turnId",
          "userMessage",
          "assistantMessage",
          "occurredAt"
        ],
        "title": "CommitTurnRequest",
        "type": "object"
      },
      "DeleteMemoryRequest": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "title": "DeleteMemoryRequest",
        "type": "object"
      },
      "ExtractionRequest": {
        "additionalProperties": false,
        "properties": {
          "assistantMessage": {
            "maxLength": 64000,
            "title": "Assistantmessage",
            "type": "string"
          },
          "occurredAt": {
            "format": "date-time",
            "title": "Occurredat",
            "type": "string"
          },
          "turnId": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Turnid",
            "type": "string"
          },
          "userMessage": {
            "maxLength": 32000,
            "minLength": 1,
            "title": "Usermessage",
            "type": "string"
          }
        },
        "required": [
          "turnId",
          "userMessage",
          "assistantMessage",
          "occurredAt"
        ],
        "title": "ExtractionRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PrepareContextRequest": {
        "additionalProperties": false,
        "properties": {
          "maxContextTokens": {
            "maximum": 64000.0,
            "minimum": 1.0,
            "title": "Maxcontexttokens",
            "type": "integer"
          },
          "query": {
            "maxLength": 16000,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query",
          "maxContextTokens"
        ],
        "title": "PrepareContextRequest",
        "type": "object"
      },
      "SearchRequest": {
        "additionalProperties": false,
        "properties": {
          "query": {
            "default": "",
            "maxLength": 16000,
            "title": "Query",
            "type": "string"
          },
          "topK": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Topk"
          },
          "types": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "USER_PREFERENCE",
                    "STABLE_FACT",
                    "USER_CONSTRAINT"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Types"
          }
        },
        "title": "SearchRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
