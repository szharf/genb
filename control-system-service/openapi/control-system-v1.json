  "components": {
    "schemas": {
      "CommitTurnRequest": {
        "properties": {
          "turnId": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Turnid"
          },
          "userMessage": {
            "type": "string",
            "maxLength": 32000,
            "minLength": 1,
            "title": "Usermessage"
          },
          "assistantMessage": {
            "type": "string",
            "maxLength": 64000,
            "title": "Assistantmessage"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "title": "Occurredat"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "turnId",
          "userMessage",
          "assistantMessage",
          "occurredAt"
        ],
        "title": "CommitTurnRequest"
      },
      "DeleteMemoryRequest": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reason"
        ],
        "title": "DeleteMemoryRequest"
      },
      "ExtractionRequest": {
        "properties": {
