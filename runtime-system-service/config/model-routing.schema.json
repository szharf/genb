{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genb.local/schemas/model-routing-v1.json",
  "title": "Runtime Inference routing configuration",
  "type": "object",
  "required": ["schemaVersion", "routes"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["modelAlias", "capabilities", "adapter"],
        "properties": {
          "modelAlias": {"type": "string", "minLength": 1},
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": ["CHAT", "STREAM", "JSON_SCHEMA", "EMBEDDING"]
            }
          },
          "adapter": {"type": "string", "minLength": 1},
          "model": {"type": "string"},
          "secretRef": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
