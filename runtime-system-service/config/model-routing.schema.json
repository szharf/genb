{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genb.local/schemas/model-routing-v1.json",
  "title": "Runtime Inference routing configuration",
  "type": "object",
  "required": ["schemaVersion", "providers", "routes"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["providerId", "type", "baseUrl", "secretRef", "timeoutMs"],
        "properties": {
          "providerId": {"type": "string", "minLength": 1},
          "type": {"const": "OPENAI_COMPATIBLE"},
          "baseUrl": {"type": "string", "minLength": 1},
          "secretRef": {"type": "string", "pattern": "^env://[A-Za-z_][A-Za-z0-9_]*$"},
          "timeoutMs": {"type": "integer", "minimum": 1, "maximum": 120000},
          "structuredOutputMode": {
            "enum": ["JSON_SCHEMA", "JSON_OBJECT"],
            "default": "JSON_SCHEMA"
          }
        },
        "additionalProperties": false
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["routeId", "modelAlias", "capabilities", "providerId", "model"],
        "properties": {
          "routeId": {"type": "string", "minLength": 1},
          "modelAlias": {"type": "string", "minLength": 1},
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["CHAT", "STREAM", "JSON_SCHEMA", "EMBEDDING"]}
          },
          "providerId": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "dimensions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1, "maximum": 4096}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
