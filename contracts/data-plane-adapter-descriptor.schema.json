{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genb.local/contracts/data-plane-adapter-descriptor.schema.json",
  "title": "GenB Compiled Data Plane Adapter Descriptor",
  "type": "object",
  "required": ["adapterCode", "adapterVersion", "supportedCapabilities", "supportedOperations"],
  "properties": {
    "adapterCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
    "adapterVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "supportedCapabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "supportedOperations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
  },
  "additionalProperties": false
}
