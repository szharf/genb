            "name": "instanceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/runtime-deployments/instances/{instanceId}/{action}": {
      "post": {
        "summary": "操作实例；停止前需撤下路由且网关已确认",
        "responses": {
          "200": {
            "description": "Result.data 返回结果"
          },
          "400": {
            "description": "参数无效"
          },
          "403": {
            "description": "无管理权限"
          },
          "409": {
            "description": "版本冲突、能力不支持或状态不允许"
          }
        },
        "parameters": [
          {
            "name": "instanceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "action",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "start",
                "stop",
                "inspect"
              ]
            }
          }
        ]
      }
    },
    "/v1/runtime-deployments/instances/{instanceId}/route/{action}": {
      "post": {
        "summary": "幂等发布或撤下路由",
        "responses": {
          "200": {
            "description": "Result.data 返回结果"
          },
          "400": {
            "description": "参数无效"
          },
          "403": {
            "description": "无管理权限"
          },
          "409": {
            "description": "版本冲突、能力不支持或状态不允许"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RouteRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "instanceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "action",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "publish",
                "withdraw"
              ]
            }
          }
        ]
      }
    },
    "/v1/runtime-deployments/agents/{agentId}/operations": {
      "post": {
        "summary": "提交幂等运维任务",
        "description": "停止类操作先撤入口并等待新鲜网关 ACK。RETIRE/ARCHIVE 确认远端回收后释放端口并保留目录；RETRY 复用材料创建新实例，不自动复制业务数据。",
        "parameters": [
          {
            "name": "agentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RuntimeOperationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result.data 为 RuntimeLifecycleOperation；提交成功不代表远端已完成"
          },
          "403": {
            "description": "需要 ADMIN/SUPER_ADMIN"
          },
          "409": {
            "description": "已有活动任务、状态不允许、幂等冲突或项目已归档；message 给出原因"
          }
        }
      }
    },
    "/v1/runtime-deployments/operations": {
      "get": {
        "summary": "按项目查询运维任务历史",
        "parameters": [
          {
            "name": "agentId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result.data 为运维任务数组，按创建时间倒序"
          },
          "403": {
            "description": "需要 ADMIN/SUPER_ADMIN"
          }
        }
      }
    },
    "/v1/runtime-deployments/operations/{operationId}/resume": {
      "post": {
        "summary": "继续核对失败运维任务",
        "description": "仅 FAILED 且未产生新部署任务时允许；不重新生成操作标识。新部署失败须在新实例发起操作。",
        "parameters": [
          {
            "name": "operationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result.data 为 RuntimeLifecycleOperation；提交成功不代表远端已完成"
          },
          "403": {
            "description": "需要 ADMIN/SUPER_ADMIN"
          },
          "409": {
            "description": "已有活动任务、状态不允许、幂等冲突或项目已归档；message 给出原因"
          }
        }
      }
    },
    "/v1/runtime-nodes/overview": {
      "get": {
        "summary": "节点分页监控总览",
        "description": "data={records:NodeObservationView[],total,page,size}。保留原 GET /runtime-nodes 数组兼容。查询不执行 SSH；未知/过期不是零资源。",
        "responses": {
          "200": {
            "description": "Result.data 为下述业务结果"
          },
          "400": {
            "description": "参数无效"
          },
          "403": {
            "description": "需要 ADMIN/SUPER_ADMIN"
          },
          "404": {
            "description": "节点不存在"
          },
          "409": {
            "description": "版本、状态、幂等或活动依赖冲突"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "in": "query",
            "name": "size",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "in": "query",
            "name": "search",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "state",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
