            "name": "nodeId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "post": {
        "summary": "创建只读异步接入检查",
        "description": "data=RuntimeNodeCheck；重复键复用；每节点最多一个活动检查。不安装软件、不部署业务，不把 SSH 连通视为完整业务验证。",
        "responses": {
          "200": {
            "description": "Result.data 为下述业务结果"
          },
          "400": {
            "description": "参数无效"
          },
          "403": {
            "description": "需要 ADMIN/SUPER_ADMIN"
          },
          "404": {
            "description": "节点不存在"
          },
          "409": {
            "description": "版本、状态、幂等或活动依赖冲突"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "nodeId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NodeCheckRequest"
              }
            }
          }
        }
      }
    },
    "/v1/runtime-nodes/{nodeId}/metrics/history": {
      "get": {
        "summary": "资源历史",
        "description": "data=NodeMetric[]；1—6小时使用原始样本，更长使用5分钟聚合，超过1000点均匀取样覆盖完整范围。",
        "responses": {
          "200": {
            "description": "Result.data 为下述业务结果"
          },
          "400": {
            "description": "参数无效"
          },
          "403": {
            "description": "需要 ADMIN/SUPER_ADMIN"
          },
          "404": {
            "description": "节点不存在"
          },
          "409": {
            "description": "版本、状态、幂等或活动依赖冲突"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "nodeId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "hours",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 168,
              "default": 1
            }
          }
        ]
      }
    },
    "/v1/runtime-nodes/{nodeId}/workloads": {
      "get": {
        "summary": "节点项目实例清单",
        "description": "data={records:[{instance,name,accessState,launchUrl,stale}],total,page,size}。项目入口指向该项目当前发布版本，不保证是本行实例；仅未回收的 GenB 托管实例。",
        "responses": {
          "200": {
            "description": "Result.data 为下述业务结果"
          },
          "400": {
            "description": "参数无效"
          },
          "403": {
            "description": "需要 ADMIN/SUPER_ADMIN"
          },
          "404": {
            "description": "节点不存在"
          },
          "409": {
            "description": "版本、状态、幂等或活动依赖冲突"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "nodeId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "in": "query",
            "name": "size",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ]
      }
    },
    "/v1/runtime-nodes/{nodeId}/alert-thresholds": {
      "put": {
        "summary": "修改告警阈值",
        "description": "阈值为使用率百分比；持续5分钟超限、持续2分钟恢复；采样不可用单独检测。",
        "responses": {
          "200": {
            "description": "Result.data 为下述业务结果"
          },
          "400": {
            "description": "参数无效"
          },
          "403": {
            "description": "需要 ADMIN/SUPER_ADMIN"
          },
          "404": {
            "description": "节点不存在"
          },
          "409": {
            "description": "版本、状态、幂等或活动依赖冲突"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "nodeId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NodeThresholdRequest"
              }
            }
          }
        }
      }
    },
    "/v1/runtime-nodes/legacy-workloads": {
      "get": {
        "summary": "旧模式部署盘点（不自动分配节点）",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result.data={records:[{agentId,name,deploymentRecords,runtimeState,port}],total,page,size}；旧状态仅登记值，部署记录数不代表运行实例数"
          },
          "403": {
            "description": "需要管理员"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "RegisterNode": {
        "type": "object",
        "required": [
          "nodeId",
          "name",
          "sshAlias"
        ],
        "properties": {
          "nodeId": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "sshAlias": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          }
        }
      },
      "NodeCapabilities": {
        "type": "object",
        "required": [
          "expectedVersion",
          "pythonAllowed",
          "dockerAllowed"
        ],
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "format": "int64"
          },
          "pythonAllowed": {
            "type": "boolean"
          },
          "dockerAllowed": {
            "type": "boolean"
          }
        }
      },
      "DeploymentRequest": {
        "type": "object",
        "required": [
          "agentId",
          "nodeId",
          "artifactId",
          "runtimeType",
          "port",
          "containerPort",
          "startupMode",
          "entryPoint",
          "memoryMb",
          "idempotencyKey"
        ],
        "properties": {
          "agentId": {
            "type": "string"
          },
          "nodeId": {
            "type": "string"
          },
          "artifactId": {
            "type": "string",
            "format": "uuid"
          },
          "runtimeType": {
            "type": "string",
            "enum": [
              "PYTHON",
              "DOCKER"
            ]
          },
          "port": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 65535
          },
          "containerPort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "startupMode": {
            "type": "string",
            "enum": [
              "SCRIPT",
              "ASGI"
            ]
          },
          "entryPoint": {
            "type": "string"
          },
          "memoryMb": {
            "type": "integer",
            "minimum": 64,
            "maximum": 2048
          },
          "idempotencyKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$"
          }
        }
      },
      "RouteRequest": {
        "type": "object",
        "required": [
          "expectedVersion",
          "idempotencyKey"
        ],
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "format": "int64"
          },
          "idempotencyKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$"
          }
        }
      },
      "RuntimeOperationRequest": {
        "type": "object",
        "required": [
          "action",
          "idempotencyKey"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "START",
              "STOP",
              "RESTART",
              "RETIRE",
              "RETRY",
              "OFFLINE",
              "ARCHIVE"
            ]
          },
          "instanceId": {
            "type": "string",
            "nullable": true,
            "description": "OFFLINE/ARCHIVE 必须不提供或为 null；其他动作必须是属于该项目的实例"
          },
          "idempotencyKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$"
          }
        }
      },
      "RuntimeLifecycleOperation": {
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string"
          },
          "agentId": {
            "type": "string"
          },
          "instanceId": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "resultJobId": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "QUEUED",
              "WAITING",
              "VERIFYING",
              "SUCCEEDED",
              "FAILED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "phaseStartedAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "NodeLifecycleRequest": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "PAUSE",
              "RESUME",
              "DRAIN",
              "RETIRE"
            ]
          },
          "expectedVersion": {
            "type": "integer"
          },
          "idempotencyKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$"
          }
        },
        "required": [
          "action",
          "expectedVersion",
          "idempotencyKey"
        ]
      },
      "NodeMetadataRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "expectedVersion": {
            "type": "integer"
          }
        },
        "required": [
          "name",
          "expectedVersion"
        ]
      },
      "NodeThresholdRequest": {
        "type": "object",
        "properties": {
          "cpu": {
            "type": "number",
            "minimum": 1,
            "maximum": 100
          },
          "memory": {
            "type": "number",
            "minimum": 1,
            "maximum": 100
          },
          "disk": {
            "type": "number",
            "minimum": 1,
            "maximum": 100
          },
          "expectedVersion": {
            "type": "integer"
          }
        },
        "required": [
          "cpu",
          "memory",
          "disk",
          "expectedVersion"
        ]
      },
      "NodeCheckRequest": {
        "type": "object",
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$"
          }
        },
        "required": [
          "idempotencyKey"
        ]
      },
      "NodeMetric": {
        "type": "object",
        "properties": {
          "sampleId": {
            "type": "string"
          },
          "nodeId": {
            "type": "string"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "sampledAt": {
            "type": "string",
            "format": "date-time"
          },
          "resolution": {
            "type": "integer",
            "enum": [
              0,
              300
            ]
          },
          "cpuPercent": {
            "type": "number"
          },
          "memoryPercent": {
            "type": "number"
          },
          "diskPercent": {
            "type": "number"
          },
          "memoryTotal": {
            "type": "integer"
          },
          "memoryAvailable": {
            "type": "integer"
          },
          "diskTotal": {
            "type": "integer"
          },
          "diskAvailable": {
            "type": "integer"
          },
          "sampleCount": {
            "type": "integer"
          },
          "cpuCount": {
            "type": "integer"
          }
        },
        "required": []
      },
      "NodeCounts": {
        "type": "object",
        "properties": {
          "projects": {
            "type": "integer"
          },
          "instances": {
            "type": "integer"
          },
          "runningProjects": {
            "type": "integer"
          },
          "running": {
            "type": "integer"
          },
          "stopped": {
            "type": "integer"
          },
          "abnormal": {
            "type": "integer"
          },
          "unknown": {
            "type": "integer"
          },
          "lastObservedRunning": {
            "type": "integer"
          }
        },
        "required": []
      },
      "NodeObservationView": {
        "type": "object",
        "properties": {
          "node": {
            "type": "object"
          },
          "observationState": {
            "type": "string",
            "enum": [
              "UNKNOWN",
              "ONLINE",
              "STALE",
              "UNREACHABLE",
              "UNSUPPORTED",
              "INVALID"
            ]
          },
          "message": {
            "type": "string"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "stale": {
            "type": "boolean"
          },
          "latest": {
            "$ref": "#/components/schemas/NodeMetric"
          },
          "counts": {
            "$ref": "#/components/schemas/NodeCounts"
          }
        },
        "required": []
      }
    }
  }
}
