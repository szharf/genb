{
  "openapi": "3.0.3",
  "info": {
    "title": "GenB 异构节点与远程部署接口",
    "version": "0.3.0",
    "description": "已实现 Python ZIP、Docker TAR、节点许可、部署任务、实例操作和网关发布。生产上下文前缀 /api；需 ADMIN/SUPER_ADMIN。 0.3 增加持久化运维任务、归档回收及继续核对；回收后实例 port 为空且可能在 JSON 中省略。"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/runtime-nodes": {
      "get": {
        "summary": "管理员查询运行节点",
        "responses": {
          "200": {
            "description": "Result.data 为 RuntimeNode 数组"
          },
          "403": {
            "description": "无 ADMIN/SUPER_ADMIN 权限"
          }
        }
      },
      "post": {
        "summary": "按运维受控 SSH 别名登记节点",
        "description": "businessHost 从 runtime.nodes.trusted-targets 推导；初始 UNKNOWN、deploymentAllowed=false。nodeId、sshAlias、businessHost 不允许重复。不会连接服务器或执行 Docker。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterNode"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result.data 为登记后的 RuntimeNode"
          },
          "400": {
            "description": "标识无效或别名未登记有效 IPv4 目标"
          },
          "403": {
            "description": "无 ADMIN/SUPER_ADMIN 权限"
          },
          "409": {
            "description": "节点标识、别名或业务地址已存在"
          }
        }
      }
    },
    "/v1/runtime-nodes/{nodeId}/capabilities": {
      "put": {
        "summary": "修改节点允许的项目类型",
        "responses": {
          "200": {
            "description": "Result.data 返回结果"
          },
          "400": {
            "description": "参数无效"
          },
          "403": {
            "description": "无管理权限"
          },
          "409": {
            "description": "版本冲突、能力不支持或状态不允许"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NodeCapabilities"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "nodeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/runtime-nodes/{nodeId}/probe": {
      "post": {
        "summary": "实时检查运行环境并更新资源观察",
        "responses": {
          "200": {
            "description": "Result.data 返回结果"
          },
          "400": {
            "description": "参数无效"
          },
          "403": {
            "description": "无管理权限"
          },
          "409": {
            "description": "版本冲突、能力不支持或状态不允许"
          }
        },
        "parameters": [
          {
            "name": "nodeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/runtime-deployments": {
      "post": {
        "summary": "幂等创建持久化部署任务",
        "responses": {
          "200": {
            "description": "Result.data 返回结果"
          },
          "400": {
            "description": "参数无效"
          },
          "403": {
            "description": "无管理权限"
          },
          "409": {
            "description": "版本冲突、能力不支持或状态不允许"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeploymentRequest"
              }
            }
          }
        },
        "description": " 已归档或有活动运维任务时拒绝；首次节点部署不能直接接管有旧部署记录的项目。历史材料复用必须提供新幂等标识和空闲端口。"
      },
      "get": {
        "summary": "按智能体查询任务",
        "responses": {
          "200": {
            "description": "Result.data 返回结果"
          },
          "400": {
            "description": "参数无效"
          },
          "403": {
            "description": "无管理权限"
          },
          "409": {
            "description": "版本冲突、能力不支持或状态不允许"
          }
        },
        "parameters": [
          {
            "name": "agentId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/runtime-deployments/artifacts": {
      "post": {
        "summary": "上传项目并登记 SHA256 材料摘要",
        "responses": {
          "200": {
            "description": "Result.data 返回结果"
          },
          "400": {
            "description": "参数无效"
          },
          "403": {
            "description": "无管理权限"
          },
          "409": {
            "description": "版本冲突、能力不支持或状态不允许"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "agentId",
                  "runtimeType",
                  "file"
                ],
                "properties": {
                  "agentId": {
                    "type": "string"
                  },
                  "runtimeType": {
                    "type": "string",
                    "enum": [
                      "PYTHON",
                      "DOCKER"
                    ]
                  },
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/runtime-deployments/instances": {
      "get": {
        "summary": "查询实例",
        "responses": {
          "200": {
            "description": "Result.data 返回结果"
          },
          "400": {
            "description": "参数无效"
          },
          "403": {
            "description": "无管理权限"
          },
          "409": {
            "description": "版本冲突、能力不支持或状态不允许"
          }
        },
        "parameters": [
          {
            "name": "agentId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/runtime-deployments/route": {
      "get": {
        "summary": "查询期望版本、网关确认版本与访问状态",
        "responses": {
          "200": {
            "description": "Result.data 返回结果"
          },
          "400": {
            "description": "参数无效"
          },
          "403": {
            "description": "无管理权限"
          },
          "409": {
            "description": "版本冲突、能力不支持或状态不允许"
          }
        },
        "parameters": [
          {
            "name": "agentId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "description": "返回项目入口、配置版本和目标 instanceId；APPLIED 仅表示网关新鲜确认，不能替代实例健康检查。"
      }
    },
    "/v1/runtime-deployments/instances/{instanceId}/logs": {
      "get": {
        "summary": "查询应用与构建日志",
        "responses": {
          "200": {
            "description": "Result.data 返回结果"
          },
          "400": {
            "description": "参数无效"
          },
          "403": {
            "description": "无管理权限"
          },
          "409": {
            "description": "版本冲突、能力不支持或状态不允许"
          }
        },
        "parameters": [
          {
            "name": "instanceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/runtime-deployments/instances/{instanceId}/{action}": {
      "post": {
        "summary": "操作实例；停止前需撤下路由且网关已确认",
        "responses": {
          "200": {
            "description": "Result.data 返回结果"
          },
          "400": {
            "description": "参数无效"
          },
          "403": {
            "description": "无管理权限"
          },
          "409": {
            "description": "版本冲突、能力不支持或状态不允许"
          }
        },
        "parameters": [
          {
            "name": "instanceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "action",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "start",
                "stop",
                "inspect"
              ]
            }
          }
        ]
      }
    },
    "/v1/runtime-deployments/instances/{instanceId}/route/{action}": {
      "post": {
        "summary": "幂等发布或撤下路由",
        "responses": {
          "200": {
            "description": "Result.data 返回结果"
          },
          "400": {
            "description": "参数无效"
          },
          "403": {
            "description": "无管理权限"
          },
          "409": {
            "description": "版本冲突、能力不支持或状态不允许"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RouteRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "instanceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "action",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "publish",
                "withdraw"
              ]
            }
          }
        ]
      }
    },
    "/v1/runtime-deployments/agents/{agentId}/operations": {
      "post": {
        "summary": "提交幂等运维任务",
        "description": "停止类操作先撤入口并等待新鲜网关 ACK。RETIRE/ARCHIVE 确认远端回收后释放端口并保留目录；RETRY 复用材料创建新实例，不自动复制业务数据。",
        "parameters": [
          {
            "name": "agentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RuntimeOperationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result.data 为 RuntimeLifecycleOperation；提交成功不代表远端已完成"
          },
          "403": {
            "description": "需要 ADMIN/SUPER_ADMIN"
          },
          "409": {
            "description": "已有活动任务、状态不允许、幂等冲突或项目已归档；message 给出原因"
          }
        }
      }
    },
    "/v1/runtime-deployments/operations": {
      "get": {
        "summary": "按项目查询运维任务历史",
        "parameters": [
          {
            "name": "agentId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result.data 为运维任务数组，按创建时间倒序"
          },
          "403": {
            "description": "需要 ADMIN/SUPER_ADMIN"
          }
        }
      }
    },
    "/v1/runtime-deployments/operations/{operationId}/resume": {
      "post": {
        "summary": "继续核对失败运维任务",
        "description": "仅 FAILED 且未产生新部署任务时允许；不重新生成操作标识。新部署失败须在新实例发起操作。",
        "parameters": [
          {
            "name": "operationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result.data 为 RuntimeLifecycleOperation；提交成功不代表远端已完成"
          },
          "403": {
            "description": "需要 ADMIN/SUPER_ADMIN"
          },
          "409": {
            "description": "已有活动任务、状态不允许、幂等冲突或项目已归档；message 给出原因"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "RegisterNode": {
        "type": "object",
        "required": [
          "nodeId",
          "name",
          "sshAlias"
        ],
        "properties": {
          "nodeId": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "sshAlias": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          }
        }
      },
      "NodeCapabilities": {
        "type": "object",
        "required": [
          "expectedVersion",
          "pythonAllowed",
          "dockerAllowed"
        ],
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "format": "int64"
          },
          "pythonAllowed": {
            "type": "boolean"
          },
          "dockerAllowed": {
            "type": "boolean"
          }
        }
      },
      "DeploymentRequest": {
        "type": "object",
        "required": [
          "agentId",
          "nodeId",
          "artifactId",
          "runtimeType",
          "port",
          "containerPort",
          "startupMode",
          "entryPoint",
          "memoryMb",
          "idempotencyKey"
        ],
        "properties": {
          "agentId": {
            "type": "string"
          },
          "nodeId": {
            "type": "string"
          },
          "artifactId": {
            "type": "string",
            "format": "uuid"
          },
          "runtimeType": {
            "type": "string",
            "enum": [
              "PYTHON",
              "DOCKER"
            ]
          },
          "port": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 65535
          },
          "containerPort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "startupMode": {
            "type": "string",
            "enum": [
              "SCRIPT",
              "ASGI"
            ]
          },
          "entryPoint": {
            "type": "string"
          },
          "memoryMb": {
            "type": "integer",
            "minimum": 64,
            "maximum": 2048
          },
          "idempotencyKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$"
          }
        }
      },
      "RouteRequest": {
        "type": "object",
        "required": [
          "expectedVersion",
          "idempotencyKey"
        ],
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "format": "int64"
          },
          "idempotencyKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$"
          }
        }
      },
      "RuntimeOperationRequest": {
        "type": "object",
        "required": [
          "action",
          "idempotencyKey"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "START",
              "STOP",
              "RESTART",
              "RETIRE",
              "RETRY",
              "OFFLINE",
              "ARCHIVE"
            ]
          },
          "instanceId": {
            "type": "string",
            "nullable": true,
            "description": "OFFLINE/ARCHIVE 必须不提供或为 null；其他动作必须是属于该项目的实例"
          },
          "idempotencyKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$"
          }
        }
      },
      "RuntimeLifecycleOperation": {
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string"
          },
          "agentId": {
            "type": "string"
          },
          "instanceId": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "resultJobId": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "QUEUED",
              "WAITING",
              "VERIFYING",
              "SUCCEEDED",
              "FAILED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "phaseStartedAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    }
  }
}
