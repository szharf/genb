{
  "openapi": "3.0.3",
  "info": {
    "title": "GenB 异构节点与远程部署接口",
    "version": "0.4.0",
    "description": "已实现 Python ZIP、Docker TAR、节点许可、部署任务、实例操作和网关发布。生产上下文前缀 /api；需 ADMIN/SUPER_ADMIN。 0.3 增加持久化运维任务、归档回收及继续核对；回收后实例 port 为空且可能在 JSON 中省略。 0.4 增加节点管理生命周期、只读监控/趋势/告警及异步接入检查；此版本当前为开发产物，生产是否升级以部署记录为准。"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/runtime-nodes": {
      "get": {
        "summary": "管理员查询运行节点",
        "responses": {
          "200": {
            "description": "Result.data 为 RuntimeNode 数组"
          },
          "403": {
            "description": "无 ADMIN/SUPER_ADMIN 权限"
          }
        }
      },
      "post": {
        "summary": "按运维受控 SSH 别名登记节点",
        "description": "businessHost 从 runtime.nodes.trusted-targets 推导；初始 UNKNOWN、deploymentAllowed=false。nodeId、sshAlias、businessHost 不允许重复。不会连接服务器或执行 Docker。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterNode"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result.data 为登记后的 RuntimeNode"
          },
          "400": {
            "description": "标识无效或别名未登记有效 IPv4 目标"
          },
          "403": {
            "description": "无 ADMIN/SUPER_ADMIN 权限"
          },
          "409": {
            "description": "节点标识、别名或业务地址已存在"
          }
        }
      }
    },
    "/v1/runtime-nodes/{nodeId}/capabilities": {
      "put": {
        "summary": "修改节点允许的项目类型",
        "responses": {
          "200": {
            "description": "Result.data 返回结果"
          },
          "400": {
            "description": "参数无效"
          },
          "403": {
            "description": "无管理权限"
          },
          "409": {
            "description": "版本冲突、能力不支持或状态不允许"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NodeCapabilities"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "nodeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/runtime-nodes/{nodeId}/probe": {
      "post": {
        "summary": "实时检查运行环境并更新资源观察",
        "responses": {
          "200": {
            "description": "Result.data 返回结果"
          },
          "400": {
            "description": "参数无效"
          },
          "403": {
            "description": "无管理权限"
          },
          "409": {
            "description": "版本冲突、能力不支持或状态不允许"
          }
        },
        "parameters": [
          {
            "name": "nodeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/runtime-deployments": {
      "post": {
        "summary": "幂等创建持久化部署任务",
        "responses": {
          "200": {
            "description": "Result.data 返回结果"
          },
          "400": {
            "description": "参数无效"
          },
          "403": {
            "description": "无管理权限"
          },
          "409": {
            "description": "版本冲突、能力不支持或状态不允许"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeploymentRequest"
              }
            }
          }
        },
        "description": " 已归档或有活动运维任务时拒绝；首次节点部署不能直接接管有旧部署记录的项目。历史材料复用必须提供新幂等标识和空闲端口。"
      },
      "get": {
        "summary": "按智能体查询任务",
        "responses": {
          "200": {
            "description": "Result.data 返回结果"
          },
          "400": {
            "description": "参数无效"
          },
          "403": {
            "description": "无管理权限"
          },
          "409": {
            "description": "版本冲突、能力不支持或状态不允许"
          }
        },
        "parameters": [
          {
            "name": "agentId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "description": " 新增可选 failureCode：NODE_PRECHECK_FAILED、ARTIFACT_TRANSFER_FAILED、REMOTE_RESULT_UNKNOWN、REMOTE_PREPARATION_FAILED、HEALTH_CHECK_FAILED；HEALTHY 清除。"
      }
    },
    "/v1/runtime-deployments/artifacts": {
      "post": {
        "summary": "上传项目并登记 SHA256 材料摘要",
        "responses": {
          "200": {
            "description": "Result.data 返回结果"
          },
          "400": {
            "description": "参数无效"
          },
          "403": {
            "description": "无管理权限"
          },
          "409": {
            "description": "版本冲突、能力不支持或状态不允许"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "agentId",
                  "runtimeType",
                  "file"
                ],
                "properties": {
                  "agentId": {
                    "type": "string"
                  },
                  "runtimeType": {
                    "type": "string",
                    "enum": [
                      "PYTHON",
                      "DOCKER"
                    ]
                  },
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/runtime-deployments/instances": {
      "get": {
        "summary": "查询实例",
        "responses": {
          "200": {
            "description": "Result.data 返回结果"
          },
          "400": {
            "description": "参数无效"
          },
          "403": {
            "description": "无管理权限"
          },
          "409": {
