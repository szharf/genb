    "/v1/runtime-nodes/{nodeId}/lifecycle": {
      "post": {
        "summary": "节点暂停/恢复/排空/退役",
        "description": "data=RuntimeNode。PAUSED/DRAINING 阻止新增部署和入口发布，已有恢复及已接受任务不受影响。RETIRE 必须先暂停或排空且没有活动依赖；不删除业务数据。",
        "responses": {
          "200": {
            "description": "Result.data 为下述业务结果"
          },
          "400": {
            "description": "参数无效"
          },
          "403": {
            "description": "需要 ADMIN/SUPER_ADMIN"
          },
          "404": {
            "description": "节点不存在"
          },
          "409": {
            "description": "版本、状态、幂等或活动依赖冲突"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "nodeId",
